# ==============================================================================
# UNA JOYA - EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# AVISO: Todas as chaves e valores abaixo são fictícios para referência de configuração.
# NENHUMA CREDENCIAL OU SEGREDO DE PRODUÇÃO CONSTA NESTE ARQUIVO.
# ==============================================================================

# Flag de Contenção do Checkout (Nuxt 4 / Nitro)
# OBRIGATÓRIO: Deve permanecer 'false' durante toda a Fase 0 de contenção emergencial.
NUXT_CHECKOUT_ENABLED=false

# Supabase (Banco de Dados & Autenticação)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_anon_public_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Mercado Pago (Gateway de Pagamentos)
MERCADOPAGO_ACCESS_TOKEN=seu_mercadopago_access_token_aqui
MERCADOPAGO_WEBHOOK_SECRET=seu_webhook_secret_hmac_aqui

# Cloudflare R2 (Armazenamento S3-Compatible de Imagens)
R2_ENDPOINT=https://seu_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=seu_r2_access_key_id_aqui
R2_SECRET_ACCESS_KEY=seu_r2_secret_access_key_aqui
R2_BUCKET_NAME=unajoya
R2_PUBLIC_URL=https://pub-seu-dominio.r2.dev

# Correios CWS API (Cálculo de Frete)
CORREIOS_USER=seu_usuario_correios_cws
CORREIOS_ACCESS_CODE=seu_codigo_acesso_cws
CORREIOS_CEP_ORIGEM=13201000

# E-mail Transacional (Nodemailer / Gmail SMTP)
GMAIL_USER=seu_email@dominio.com.br
GMAIL_APP_PASSWORD=sua_senha_de_app_aqui
